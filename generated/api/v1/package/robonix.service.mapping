{
  "name": "robonix.service.mapping",
  "version": "0.5.0",
  "description": "SLAM mapping service. Algo + sensor inputs config-driven.",
  "license": "MulanPSL-2.0",
  "tags": [
    "service",
    "mapping",
    "slam",
    "rtabmap",
    "ros2"
  ],
  "repo": "https://github.com/syswonder/service-map-rbnx",
  "maintainers": [
    "wheatfox <wheatfox17@icloud.com>"
  ],
  "repo_name": "service-map-rbnx",
  "default_branch": "main",
  "kind": "service",
  "catalog_type": "package",
  "manifest": "package_manifest.yaml",
  "capabilities": [
    "robonix/service/map/occupancy_grid",
    "robonix/service/map/pointcloud",
    "robonix/service/map/pose",
    "robonix/service/map/odom",
    "robonix/service/map/lifecycle",
    "robonix/service/map/save_map",
    "robonix/service/map/list_maps",
    "robonix/service/map/load_map",
    "robonix/service/map/pose_estimate",
    "robonix/service/map/switch_mode"
  ],
  "deploy_dependencies": [],
  "readme_url": "https://github.com/syswonder/service-map-rbnx/blob/main/README.md",
  "preview_image_url": ""
}
