{
  "name": "robonix.robot.unitree.go2",
  "version": "0.1.0",
  "description": "Safe Robonix deployment for Unitree Go2 with mapping, semantic navigation and read-only UI.",
  "license": "Apache-2.0 AND BSD-3-Clause AND MIT AND (EPL-2.0 OR EDL-1.0)",
  "tags": [
    "robot",
    "deploy",
    "unitree",
    "go2",
    "quadruped",
    "lidar",
    "camera",
    "imu",
    "mapping",
    "navigation",
    "speech"
  ],
  "repo": "https://github.com/syswonder/robot-unitree-go2",
  "maintainers": [
    "Origamii520 <Origamii520@users.noreply.github.com>"
  ],
  "repo_name": "robot-unitree-go2",
  "default_branch": "main",
  "kind": "robot",
  "catalog_type": "robot",
  "catalog_status": "ok",
  "catalog_warnings": [],
  "manifest": "robonix_manifest.yaml",
  "capabilities": [],
  "deploy_dependencies": [
    {
      "section": "primitive",
      "name": "go2_chassis",
      "repo": "",
      "path": "${ROBONIX_DEPLOY_DIR}/packages/go2_chassis",
      "branch": "",
      "manifest": "",
      "resolution": "robonix_deploy",
      "package_name": "",
      "package_url": "",
      "resolution_warning": ""
    },
    {
      "section": "primitive",
      "name": "go2_sensors",
      "repo": "",
      "path": "${ROBONIX_DEPLOY_DIR}/packages/go2_sensors",
      "branch": "",
      "manifest": "",
      "resolution": "robonix_deploy",
      "package_name": "",
      "package_url": "",
      "resolution_warning": ""
    },
    {
      "section": "primitive",
      "name": "robot_description",
      "repo": "",
      "path": "${ROBONIX_DEPLOY_DIR}/packages/go2_description",
      "branch": "",
      "manifest": "",
      "resolution": "robonix_deploy",
      "package_name": "",
      "package_url": "",
      "resolution_warning": ""
    },
    {
      "section": "primitive",
      "name": "audio_client_bridge",
      "repo": "",
      "path": "${ROBONIX_SOURCE_PATH}/examples/webots/primitives/audio_client_bridge",
      "branch": "",
      "manifest": "",
      "resolution": "robonix_source",
      "package_name": "",
      "package_url": "",
      "resolution_warning": ""
    },
    {
      "section": "service",
      "name": "mapping",
      "repo": "https://github.com/syswonder/service-map-rbnx",
      "path": "",
      "branch": "main",
      "manifest": "",
      "resolution": "catalog",
      "package_name": "robonix.service.mapping",
      "package_url": "../robonix.service.mapping/",
      "resolution_warning": ""
    },
    {
      "section": "service",
      "name": "speech",
      "repo": "",
      "path": "${ROBONIX_SOURCE_PATH}/services/speech",
      "branch": "",
      "manifest": "",
      "resolution": "robonix_source",
      "package_name": "",
      "package_url": "",
      "resolution_warning": ""
    },
    {
      "section": "service",
      "name": "nav2",
      "repo": "https://github.com/syswonder/service-navigation-rbnx",
      "path": "",
      "branch": "main",
      "manifest": "",
      "resolution": "catalog",
      "package_name": "robonix.service.navigation",
      "package_url": "../robonix.service.navigation/",
      "resolution_warning": ""
    },
    {
      "section": "service",
      "name": "go2_dashboard",
      "repo": "",
      "path": "${ROBONIX_DEPLOY_DIR}/packages/go2_dashboard",
      "branch": "",
      "manifest": "",
      "resolution": "robonix_deploy",
      "package_name": "",
      "package_url": "",
      "resolution_warning": ""
    },
    {
      "section": "skill",
      "name": "semantic_navigation",
      "repo": "",
      "path": "${ROBONIX_DEPLOY_DIR}/packages/semantic_navigation",
      "branch": "",
      "manifest": "",
      "resolution": "robonix_deploy",
      "package_name": "",
      "package_url": "",
      "resolution_warning": ""
    }
  ],
  "readme_url": "https://github.com/syswonder/robot-unitree-go2/blob/main/README.md",
  "preview_image_url": "",
  "deployment_status": "ok",
  "deployment_warnings": []
}
